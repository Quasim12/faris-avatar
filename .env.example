# Copy this file to .env.local and fill in your own values.

# Chat + embeddings (used by server.py). Any OpenAI-compatible provider works.
# Free option: Google Gemini. Get a key at https://aistudio.google.com/apikey
LLM_API_KEY=your-gemini-api-key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_CHAT_MODEL=gemini-3.8-flash
EMBED_MODEL=gemini-embedding-001
# Optional: use a different provider only for embeddings
# EMBED_API_KEY=
# EMBED_BASE_URL=

# LiveKit (used by BOTH server.py and agent.py, same project)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Synthesia + Cartesia (used by agent.py)
SYNTHESIA_API_KEY=your-synthesia-api-key
SYNTHESIA_AVATAR_ID=your-synthesia-avatar-id
CARTESIA_VOICE_ID=your-cartesia-voice-id

# Optional
BACKEND_URL=http://localhost:8080/api/avatar/ask
PORT=8080
OWNER_NAME=Md Kasim
ASSISTANT_NAME=Faris
HISTORY_MESSAGES=12
